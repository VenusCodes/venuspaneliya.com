{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" } ] },
    { "source": "/admin/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/(.*).md", "headers": [ { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }, { "key": "X-Robots-Tag", "value": "noindex" } ] }
  ],
  "redirects": [
    { "source": "/blog/:path*", "destination": "/writing/:path*", "permanent": true },
    { "source": "/projects/:path*", "destination": "/work/:path*", "permanent": true },
    { "source": "/tech/:path*", "destination": "/stack/:path*", "permanent": true }
  ]
}
